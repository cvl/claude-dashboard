#!/usr/bin/env bash
set -euo pipefail

AGENT_CHAT_PY="/usr/local/lib/claude-dashboard/agent-chat.py"

git_root_name() {
  local root
  root=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null) || { basename "$(pwd)"; return; }
  basename "$root"
}

show_help() {
  echo "cdash — Claude Dashboard CLI"
  echo ""
  echo "Usage:"
  echo "  cdash claude [--project P] [--name N] [args...]  Launch Claude (--effort max default)"
  echo "  cdash codex  [--project P] [--name N] [args...]  Launch Codex"
  echo "  cdash <name>                                     Register terminal tab"
  echo "  cdash chat send \"message\" [--to NAME]            Send chat message"
  echo "  cdash chat send \"message\" --to human             Escalate to human"
  echo "  cdash chat read [--all]                          Read chat messages"
  echo "  cdash chat list                                  List sessions in channel"
  echo "  cdash --help                                     Show this help"
  echo "  cdash chat --help                                Show chat help"
  echo ""
  echo "Options:"
  echo "  --project P   Chat channel / project name (default: git root)"
  echo "  --name N      Session display name (default: folder name)"
}

show_chat_help() {
  echo "cdash chat — Inter-agent communication"
  echo ""
  echo "Messaging:"
  echo "  cdash chat send \"msg\"                Broadcast (stored, no interruption)"
  echo "  cdash chat send \"msg\" --to NAME      Direct message (interrupts that agent)"
  echo "  cdash chat send \"msg\" --to human     Escalate to human (triggers notification)"
  echo "  cdash chat send \"msg\" --all          Urgent broadcast (interrupts ALL agents)"
  echo "  cdash chat read                      Show new messages since last read"
  echo "  cdash chat read --all                Show all messages (last 5 days)"
  echo "  cdash chat list                      Show agents in current channel"
  echo ""
  echo "Codex Desktop (attach external tasks to chat):"
  echo "  cdash chat attach                    Register current task (uses CODEX_THREAD_ID)"
  echo "  cdash chat attach --thread UUID      Register with explicit thread ID"
  echo "  cdash chat detach                    Unregister (preserves history)"
  echo "  cdash chat status                    Show attachment state and delivery info"
  echo "  cdash chat retry --message-id N --to NAME   Retry failed delivery"
  echo ""
  echo "External agents (not launched via cdash):"
  echo "  cdash chat send \"msg\" --name myagent --project myproject"
  echo "  cdash chat read --name myagent --project myproject"
  echo "  cdash chat attach --name myagent --project myproject --thread UUID"
  echo ""
  echo "Broadcasts are stored but not injected — agents see them on next read."
  echo "Use --all only when all agents must act immediately."
  echo "Attached Codex tasks receive DMs via codex queue (no PTY needed)."
}

if [ $# -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  show_help
  exit 0
fi

# ── Chat subcommand ──
if [ "$1" = "chat" ]; then
  shift
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_chat_help; exit 0
  fi
  subcmd="${1:-read}"; shift 2>/dev/null || true

  agent_type="${CDASH_AGENT_TYPE:-claude}"
  pid="${CDASH_PID:-$$}"
  proxy_pid="${CDASH_PROXY_PID:-}"

  # Check for explicit --name and --project flags (for external agents)
  explicit_name=""
  explicit_project=""
  args_rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) explicit_name="$2"; shift 2 ;;
      --project) explicit_project="$2"; shift 2 ;;
      *) args_rest+=("$1"); shift ;;
    esac
  done
  set -- "${args_rest[@]+"${args_rest[@]}"}"

  if [ -n "$explicit_name" ] && [ -n "$explicit_project" ]; then
    session_name="$explicit_name"
    project="$explicit_project"
  else
    # Session name + channel: state file is the single source of truth
    result=$(python3 -c "
import os, json, subprocess, sqlite3
state_dir = '/tmp/claude-dash'
pids = set()
p = os.getpid()
while p > 1:
    pids.add(p)
    try:
        out = subprocess.check_output(['ps', '-o', 'ppid=', '-p', str(p)], text=True).strip()
        p = int(out) if out else 0
    except: break
name = ''
for fname in os.listdir(state_dir):
    if not fname.endswith('.state'): continue
    pid = int(fname[:-6])
    if pid in pids:
        with open(f'{state_dir}/{fname}') as f:
            d = json.load(f)
            name = d.get('name', '')
            if name: break
if not name: name = os.environ.get('CDASH_SESSION_NAME', os.path.basename(os.getcwd()))
channel = ''
db_path = os.path.expanduser('~/.claude/dashboard-chat.db')
if os.path.exists(db_path):
    db = sqlite3.connect(db_path)
    db.execute('PRAGMA journal_mode=WAL')
    row = db.execute('SELECT project_id FROM sessions WHERE display_name=? ORDER BY last_seen DESC LIMIT 1', (name,)).fetchone()
    if row: channel = row[0]
    db.close()
print(f'{name}|{channel}')
" 2>/dev/null)
    session_name="${result%%|*}"
    project="${result#*|}"
    if [ -z "$session_name" ]; then
      echo "Error: no cdash session found. Use --name and --project, or launch with: cdash claude" >&2
      exit 1
    fi
    project="${project:-${CDASH_PROJECT:-$(git_root_name)}}"
  fi

  case "$subcmd" in
    send)
      msg="${1:-}"; shift 2>/dev/null || true
      extra_args=""
      if [ "${1:-}" = "--to" ]; then
        extra_args="--to ${2:-}"
        shift 2 2>/dev/null || true
      elif [ "${1:-}" = "--all" ]; then
        extra_args="--all"
        shift 2>/dev/null || true
      fi
      python3 "$AGENT_CHAT_PY" send --project "$project" --name "$session_name" \
        --type "$agent_type" --pid "$pid" ${proxy_pid:+--proxy-pid "$proxy_pid"} \
        ${extra_args} --message "$msg"
      ;;
    read)
      python3 "$AGENT_CHAT_PY" read --project "$project" --name "$session_name" \
        --type "$agent_type" --pid "$pid" ${proxy_pid:+--proxy-pid "$proxy_pid"} "$@"
      ;;
    list)
      python3 "$AGENT_CHAT_PY" list --project "$project" "$@"
      ;;
    attach)
      python3 "$AGENT_CHAT_PY" attach --name "$session_name" --project "$project" "$@"
      ;;
    detach)
      python3 "$AGENT_CHAT_PY" detach --name "$session_name" --project "$project"
      ;;
    status)
      python3 "$AGENT_CHAT_PY" status --name "$session_name" --project "$project"
      ;;
    retry)
      python3 "$AGENT_CHAT_PY" retry "$@"
      ;;
    *)
      echo "Unknown chat command: $subcmd" >&2
      echo "Usage: cdash chat <send|read|list|attach|detach|status|retry>" >&2
      exit 1
      ;;
  esac
  exit 0
fi

# ── Agent launch (claude|codex) with optional --project/--name ──
case "$1" in
  claude|codex)
    agent_type="$1"; shift

    # Parse --project and --name flags (--name passed through to claude only, codex doesn't support it)
    project=""
    session_name=""
    agent_args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="$2"; shift 2 ;;
        --name)    session_name="$2"
                   [ "$agent_type" = "claude" ] && agent_args+=("--name" "$2")
                   shift 2 ;;
        *)         agent_args+=("$1"); shift ;;
      esac
    done

    export CDASH_PROJECT="${project:-$(git_root_name)}"
    export CDASH_SESSION_NAME="${session_name:-$(basename "$(pwd)")}"
    export CDASH_AGENT_TYPE="$agent_type"
    export CDASH_PROXY=1
    # Default --effort max for claude
    if [ "$agent_type" = "claude" ]; then
      has_effort=false
      for a in "${agent_args[@]+"${agent_args[@]}"}"; do
        [ "$a" = "--effort" ] && has_effort=true
      done
      [ "$has_effort" = "false" ] && agent_args+=("--effort" "max")
    fi
    exec claude-dashboard-proxy "$agent_type" "${agent_args[@]+"${agent_args[@]}"}"
    ;;
esac

# ── Terminal registration (cdash <name>) ──
name="$1"
tty_name=$(tty | sed 's|/dev/||')
cwd="$(pwd)"
pid=$PPID
file="$HOME/.claude/dashboard-terminals.json"
mkdir -p "$(dirname "$file")"

python3 -c "
import json, os, sys, time
f, name, tty, cwd, pid = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5])
d = {}
if os.path.exists(f):
    with open(f) as fh:
        d = json.load(fh)
d[name] = {'name': name, 'tty': tty, 'cwd': cwd, 'pid': pid, 'registeredAt': time.time()}
with open(f, 'w') as fh:
    json.dump(d, fh)
" "$file" "$name" "$tty_name" "$cwd" "$pid"

# Assign to first tab
tabs_file="$HOME/.claude/dashboard-tabs.json"
assigned_tab=$(python3 -c "
import json, os, sys
tabs_file, name = sys.argv[1], sys.argv[2]
if not os.path.exists(tabs_file): sys.exit(0)
with open(tabs_file) as f:
    tabs = json.load(f)
if not tabs: sys.exit(0)
for t in tabs:
    if name in t.get('terminalTTYs', []):
        t['terminalTTYs'].remove(name)
first = tabs[0]
if name not in first.get('terminalTTYs', []):
    first.setdefault('terminalTTYs', []).append(name)
with open(tabs_file, 'w') as f:
    json.dump(tabs, f)
print(first.get('name', first.get('id', 'main')))
" "$tabs_file" "$name" 2>/dev/null)

echo "Registered '$name' ($tty_name) in tab '${assigned_tab:-first}'"
