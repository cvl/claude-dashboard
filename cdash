#!/usr/bin/env bash
set -euo pipefail

AGENT_CHAT_PY="/usr/local/lib/claude-dashboard/agent-chat.py"

git_root_name() {
  local root
  root=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null) || { basename "$(pwd)"; return; }
  basename "$root"
}

if [ $# -eq 0 ]; then
  echo "Usage:"
  echo "  cdash <name>                          Register terminal tab"
  echo "  cdash claude [--project P] [--name N] [args...]  Launch Claude"
  echo "  cdash codex  [--project P] [--name N] [args...]  Launch Codex"
  echo "  cdash chat send \"message\" [--to NAME] Send chat message"
  echo "  cdash chat read [--all]               Read chat messages"
  echo "  cdash chat list                       List sessions in project"
  exit 1
fi

# ── Chat subcommand ──
if [ "$1" = "chat" ]; then
  shift
  subcmd="${1:-read}"; shift 2>/dev/null || true

  project="${CDASH_PROJECT:-$(git_root_name)}"
  agent_type="${CDASH_AGENT_TYPE:-claude}"
  pid="${CDASH_PID:-$$}"
  proxy_pid="${CDASH_PROXY_PID:-}"

  # Session name: env var > Claude/Codex session file name > cwd basename
  session_name="${CDASH_SESSION_NAME:-}"
  if [ -z "$session_name" ]; then
    session_name=$(python3 -c "
import json, os, glob
pid = $pid
for f in glob.glob(os.path.expanduser('~/.claude/sessions/*.json')):
    try:
        d = json.load(open(f))
        if d.get('pid') == pid:
            print(d.get('name', '')); break
    except: pass
" 2>/dev/null)
    session_name="${session_name:-$(basename "$(pwd)")}"
  fi

  case "$subcmd" in
    send)
      msg="${1:-}"; shift 2>/dev/null || true
      to_args=""
      if [ "${1:-}" = "--to" ]; then
        to_args="--to ${2:-}"
        shift 2 2>/dev/null || true
      fi
      python3 "$AGENT_CHAT_PY" send --project "$project" --name "$session_name" \
        --type "$agent_type" --pid "$pid" ${proxy_pid:+--proxy-pid "$proxy_pid"} \
        ${to_args} --message "$msg"
      ;;
    read)
      python3 "$AGENT_CHAT_PY" read --project "$project" --name "$session_name" \
        --type "$agent_type" --pid "$pid" ${proxy_pid:+--proxy-pid "$proxy_pid"} "$@"
      ;;
    list)
      python3 "$AGENT_CHAT_PY" list --project "$project" "$@"
      ;;
    *)
      echo "Unknown chat command: $subcmd" >&2
      echo "Usage: cdash chat <send|read|list>" >&2
      exit 1
      ;;
  esac
  exit 0
fi

# ── Agent launch (claude|codex) with optional --project/--name ──
case "$1" in
  claude|codex)
    agent_type="$1"; shift

    # Parse --project and --name flags
    project=""
    session_name=""
    agent_args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --project) project="$2"; shift 2 ;;
        --name)    session_name="$2"; shift 2 ;;
        *)         agent_args+=("$1"); shift ;;
      esac
    done

    export CDASH_PROJECT="${project:-$(git_root_name)}"
    export CDASH_SESSION_NAME="${session_name:-$(basename "$(pwd)")}"
    export CDASH_AGENT_TYPE="$agent_type"
    export CDASH_PROXY=1
    exec claude-dashboard-proxy "$agent_type" "${agent_args[@]+"${agent_args[@]}"}"
    ;;
esac

# ── Terminal registration (cdash <name>) ──
name="$1"
tty_name=$(tty | sed 's|/dev/||')
cwd="$(pwd)"
pid=$PPID
file="$HOME/.claude/dashboard-terminals.json"
mkdir -p "$(dirname "$file")"

active_tab_file="$HOME/.claude/dashboard-active-tab"
active_tab=$(cat "$active_tab_file" 2>/dev/null || echo "main")

python3 -c "
import json, os, sys, time
f, name, tty, cwd, pid = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5])
d = {}
if os.path.exists(f):
    with open(f) as fh:
        d = json.load(fh)
d[name] = {'name': name, 'tty': tty, 'cwd': cwd, 'pid': pid, 'registeredAt': time.time()}
with open(f, 'w') as fh:
    json.dump(d, fh)
" "$file" "$name" "$tty_name" "$cwd" "$pid"

# Assign to active tab if not main
if [ "$active_tab" != "main" ]; then
  tabs_file="$HOME/.claude/dashboard-tabs.json"
  python3 -c "
import json, os, sys
tabs_file, name, tab_id = sys.argv[1], sys.argv[2], sys.argv[3]
if not os.path.exists(tabs_file): sys.exit(0)
with open(tabs_file) as f:
    tabs = json.load(f)
for t in tabs:
    if name in t.get('terminalTTYs', []):
        t['terminalTTYs'].remove(name)
for t in tabs:
    if t['id'] == tab_id and name not in t.get('terminalTTYs', []):
        t.setdefault('terminalTTYs', []).append(name)
with open(tabs_file, 'w') as f:
    json.dump(tabs, f)
" "$tabs_file" "$name" "$active_tab"
fi

echo "Registered '$name' ($tty_name) in tab '$active_tab'"
